# Copy to .env for LOCAL development only. Never commit .env.
# In Azure every secret comes from Key Vault; see docs/DEPLOYMENT.md.

NODE_ENV=development
PORT=3000
# 127.0.0.1 = reachable from this machine only. The container image uses 0.0.0.0.
HOST=127.0.0.1
LOG_LEVEL=info
PUBLIC_BASE_URL=http://localhost:3000
# Vite dev server origin, so the SPA on :5173 can make mutating requests through the proxy.
ALLOWED_ORIGINS=http://localhost:5173
# Serve the built SPA from the API (production-like). Leave empty when using `npm run dev:web`.
STATIC_DIR=

DATABASE_URL=postgresql://adometrics:change-me@localhost:5432/adometrics

# Generate with: openssl rand -base64 48
SESSION_SECRET=
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8

# dev = local persona chooser (refused when NODE_ENV=production); entra = Microsoft Entra ID.
AUTH_MODE=dev
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Company email domains allowed to sign in (comma separated), e.g. cspl.com. Guests are always refused.
ALLOWED_EMAIL_DOMAINS=
# Who can open Admin (sync, categories, audit log), comma separated. Everyone else sees only their own projects.
ADMIN_EMAILS=

ADO_ORG_URL=https://dev.azure.com/your-org
# managed-identity (Azure) | client-secret (AZURE_TENANT_ID/AZURE_CLIENT_ID/AZURE_CLIENT_SECRET) | pat (local only)
ADO_AUTH=pat
ADO_PAT=
# Optional comma-separated project names to sync; empty = every project the identity can read.
ADO_PROJECTS=
# Only sync this team's board (e.g. UX). Empty = whole project.
ADO_TEAM=
# true = no background sync (e.g. when exploring with `npm run seed:demo` data).
SYNC_DISABLED=true
SYNC_INTERVAL_SECONDS=10
SYNC_LOOKBACK_DAYS=730

# Near-real-time change notifications: none | storage | servicebus
CHANGE_QUEUE_KIND=none
CHANGE_QUEUE_URL=
WEBHOOK_BASIC_USER=
WEBHOOK_BASIC_PASSWORD=

RETENTION_DAYS=730
DELAY_BLOCKED_HOURS=48

# Password for the docker compose PostgreSQL container (local only): openssl rand -hex 24
POSTGRES_PASSWORD=

# Names shown in the Teammates panel, matched to the start of each name. Empty = everyone.
TEAMMATES=
