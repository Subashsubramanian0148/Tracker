{
  "name": "@ado-metrics/api",
  "version": "0.1.0",
  "private": true,
  "description": "Backend-for-frontend: Entra ID auth, Azure DevOps sync, metrics engine, delay reasons, audit log.",
  "scripts": {
    "build": "prisma generate && nest build",
    "dev": "nest start --watch --exec \"node --env-file=../../.env\"",
    "start": "node dist/main.js",
    "typecheck": "prisma generate && tsc --noEmit -p tsconfig.json",
    "lint": "eslint src test",
    "test": "jest",
    "test:cov": "jest --coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "seed:demo": "node dist/scripts/seed-demo.js",
    "ado:check": "node --env-file=../../.env dist/scripts/check-ado.js"
  },
  "dependencies": {
    "@ado-metrics/shared": "^0.1.0",
    "@azure/identity": "^4.14.0",
    "@azure/msal-node": "^7.1.1",
    "@azure/service-bus": "^7.10.0",
    "@azure/storage-queue": "^12.32.0",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "html-to-text": "^10.0.1",
    "nestjs-pino": "^5.3.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/testing": "^11.2.7",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/html-to-text": "^9.0.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "pino-pretty": "^13.2.0",
    "prisma": "^7.10.1",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15"
  }
}
